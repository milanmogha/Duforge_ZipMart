# Copy to .env and fill in. Only EXPO_PUBLIC_* vars are exposed to the app bundle.

# Backend API base (include /api). Use your LAN IP for a physical device,
# 10.0.2.2 for the Android emulator, localhost for iOS simulator.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Socket.IO server (no /api suffix), used for live support + order tracking.
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:8000

# Google Maps / Directions key used for reverse-geocode + distance calls in JS.
# (The NATIVE map key for react-native-maps rendering is set in app.json.)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=REPLACE_WITH_YOUR_KEY
