# ===== ZipMart monorepo root .gitignore =====

# Local AI coding tool state — not project source
.commandcode/

# Dependencies
node_modules/
**/node_modules/

# Native projects (regenerated by `expo prebuild` — do not commit)
**/android/
**/ios/

# Archived native folders from the bare->managed conversion (contain keystores/secrets)
**/_native_backup/

# Expo / Metro
**/.expo/
**/dist/
**/web-build/
expo-env.d.ts
.metro-health-check*

# Web build output (Vite/React)
**/build/
**/.vite/
**/coverage/
**/.cache/

# Per-workspace lockfiles — the monorepo has ONE lockfile at the root
apps/*/package-lock.json
packages/*/package-lock.json

# Generated PDF invoices (runtime output, not source)
apps/backend/invoices/

# ===== Secrets — never commit =====
# Signing keystores & keys
*.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# Environment files (keep an .env.example instead)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
# Firebase Admin service-account keys (server-side)
**/serviceAccount*.json
**/firebase-adminsdk*.json

# Logs & debug
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# TypeScript / build info
*.tsbuildinfo

# Gradle
**/.gradle/

# Editors / OS
.idea/
.vscode/
.DS_Store
*.pem
Thumbs.db

# NOTE: google-services.json / GoogleService-Info.plist are intentionally NOT ignored —
# the Customer app's build needs them and they are client config (safe in a PRIVATE repo).
# If you prefer to keep them out of git, uncomment:
# **/google-services.json
# **/GoogleService-Info.plist

